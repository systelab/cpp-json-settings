def version = "0.0.0"
def profile = "vs2022.conanprofile"
def packageNameInterface = "json-settings"
def packageNameRESTAPI = "json-settings-restapi"
def packageNameTestUtilities = "json-settings-test-utilities"
def archs = ['x86', 'x86_64']
def configs = ['Debug', 'Release']

@Library('aid-pipeline-utils@1.0.23') _
   
pipeline
{
	agent
	{
		label 'lib-build'
	}

	environment
	{
		PATH = "${env.USERPROFILE}\\.venvs\\conan2\\Scripts;${env.PATH}"
	}

	parameters
	{
		string(	name: 'tag',
 				description: 'Version to build (must match the version of the tag that will be checked out), leave blank for checkout of current branch',
 				defaultValue: '',
 				trim: true)
 
 		booleanParam( name: 'uploadPackage',
 					  description: 'Whether or not to upload conan package',
 					  defaultValue: false )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				cleanupWorkspace()
 				script 
 				{
 					if (params.tag == '')
 					{
 						checkoutFromGIT()
 					}
 					else
 					{
 						version = params.tag
 						checkoutFromGIT(scm.userRemoteConfigs[0].url, "v${version}", true)
 					}
 				}
			}
		}
		
		stage('Build')
		{	
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							stage("Build ${packageNameInterface} ${config}|${arch}")
							{
								def buildFolder = "build/${packageNameInterface}-${config}-${arch}"
								def conanContext = "--profile:all=${profile} --settings:all arch=${arch} --settings:all build_type=${config}"
								bat script: "conan install . --output-folder ${buildFolder} ${conanContext}", label: 'Installing dependencies'
								bat script: "conan build . --output-folder ${buildFolder} ${conanContext}", label: 'Building'		
								bat script: "conan export-pkg . --name=${packageNameInterface} --version=${version} --output-folder ${buildFolder} ${conanContext} -tf=\"\"", label: "Exporting package ${packageNameInterface}/${version}"
								dir("${buildFolder}/bin/${config}")
								{
									bat "JSONSettingsTest.exe --gtest_output=xml:JSONSettingsTest.xml"
								}
							}
							
							stage("Build ${packageNameTestUtilities} ${config}|${arch}")
							{
								def buildFolder = "build/${packageNameTestUtilities}-${config}-${arch}"
								def conanContext = "--profile:all=${profile} --settings:all arch=${arch} --settings:all build_type=${config}"
								bat script: "conan install test/JSONSettingsTestUtilities/conanfile.py --version=${version} --output-folder ${buildFolder} ${conanContext}", label: 'Installing dependencies'
								bat script: "conan build test/JSONSettingsTestUtilities/conanfile.py --version=${version} --output-folder ${buildFolder} ${conanContext}", label: 'Building'		
								bat script: "conan export-pkg test/JSONSettingsTestUtilities/conanfile.py --name=${packageNameTestUtilities} --version=${version} --output-folder ${buildFolder} ${conanContext} -tf=\"\"", label: "Exporting package ${packageNameTestUtilities}/${version}"
							}
							
							stage("Build ${packageNameRESTAPI} ${config}|${arch}")
							{
								def buildFolder = "build/${packageNameRESTAPI}-${config}-${arch}"
								def conanContext = "--profile:all=${profile} --settings:all arch=${arch} --settings:all build_type=${config}"
								bat script: "conan install src/JSONSettingsRESTAPI/conanfile.py --version=${version} --output-folder ${buildFolder} ${conanContext}", label: 'Installing dependencies'
								bat script: "conan build src/JSONSettingsRESTAPI/conanfile.py --version=${version} --output-folder ${buildFolder} ${conanContext}", label: 'Building'		
								bat script: "conan export-pkg src/JSONSettingsRESTAPI/conanfile.py --name=${packageNameRESTAPI} --version=${version} --output-folder ${buildFolder} ${conanContext} -tf=\"\"", label: "Exporting package ${packageNameRESTAPI}/${version}"
								dir("${buildFolder}/bin/${config}")
								{
									bat "JSONSettingsRESTAPITest.exe --gtest_output=xml:JSONSettingsRESTAPITest.xml"
								}
							}
						}
					}
				}
			}
		}

		stage('Test Packages')
		{
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							def conanContext = "--profile:all=${profile} --settings:all arch=${arch} --settings:all build_type=${config}"
							bat script: "conan test test_package/conanfile.py ${packageNameInterface}/${version} ${conanContext}"
							bat script: "conan test test/JSONSettingsTestUtilities/test_package/conanfile.py ${packageNameTestUtilities}/${version} ${conanContext}"
							bat script: "conan test src/JSONSettingsRESTAPI/test_package/conanfile.py ${packageNameRESTAPI}/${version} ${conanContext}"
						}
					}
				}
			}
		}

		stage('Deploy')
		{
			when
			{
				expression { return params.uploadPackage }
			}
			steps
			{
				script
				{
					bat script: "conan upload ${packageNameInterface}/${version} --remote=aid-conan-production-local --confirm --force", label: "Uploading ${packageNameInterface} package to artifactory"
					bat script: "conan upload ${packageNameRESTAPI}/${version} --remote=aid-conan-production-local --confirm --force", label: "Uploading ${packageNameRESTAPI} package to artifactory"
					bat script: "conan upload ${packageNameTestUtilities}/${version} --remote=aid-conan-production-local --confirm --force", label: "Uploading ${packageNameTestUtilities} package to artifactory"
				}
			}
		}
	}
	
	post
	{
		always
		{
			junit allowEmptyResults: true, testResults: "build*/**/JSONSettingsTest.xml"
			junit allowEmptyResults: true, testResults: "build*/**/JSONSettingsRESTAPITest.xml"
			script
 			{
 				currentBuild.description = "${version}"
 			}
 			cleanupWorkspace()
		}
	}
}